# Copy to .env (never commit it) and export before running:  set -a; source .env; set +a
# Binance API keys - only needed when CONFIG["live"] = True. Use futures-only keys, NO withdrawal permission.
BINANCE_KEY=
BINANCE_SECRET=
# Optional sentiment sources
X_BEARER_TOKEN=
CRYPTOPANIC_TOKEN=
# Dashboard port (default 8000)
PORT=8000
